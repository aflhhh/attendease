# Required. Use a MongoDB Atlas SRV URI for Vercel; localhost only works locally.
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=attendanceDB
PORT=3000

# Generate separate random secrets (at least 40 characters) for each variable.
SESSION_SECRET=replace-with-a-random-secret-at-least-40-characters-long
SETUP_SECRET=replace-with-a-different-random-setup-key
CRON_SECRET=replace-with-a-third-random-cron-secret

# Optional SMTP settings; email alerts are disabled until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Optional comma-separated recipients; if empty, active administrators are used.
ALERT_EMAIL_TO=
